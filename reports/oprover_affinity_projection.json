    }
  },
  "model": {
    "normalized_independent_attempt_cpu": 1.0,
    "affinity_group_cpu_formula": "p + n * (1 - p)",
    "independent_batch_waves_formula": "ceil(groups * n / verifier_slots)",
    "affinity_batch_time_formula": "ceil(groups / verifier_slots) * (p + n * (1 - p))",
    "cpu_throughput_multiplier_formula": "n / (p + n * (1 - p))",
    "assumptions": [
      "every complete attempt has equal normalized cost",
      "every group has one exact shared prefix with CPU fraction p",
      "one affinity group occupies one verifier slot and executes unchanged suffixes serially",
      "independent attempts and affinity groups are work-conserving within whole waves",
      "dispatch, trie, snapshot, and attribution overhead are zero"
    ]
  },
