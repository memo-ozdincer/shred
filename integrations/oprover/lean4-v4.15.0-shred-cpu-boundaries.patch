+static std::atomic<uint64_t> g_shred_sequence {0};
+static thread_local unsigned g_shred_depth = 0;
+
+static bool shred_boundary_category(std::string const & category) {
+    return category == "parsing" || category == "elaboration" ||
+        category.rfind("shred tactic execution@", 0) == 0;
+}
+
+static bool shred_cpu_now(uint64_t & result) {
+#if defined(LEAN_WINDOWS)
+    return false;
+#else
+    struct rusage self_usage;
+    struct rusage child_usage;
+    if (getrusage(RUSAGE_SELF, &self_usage) != 0 ||
+        getrusage(RUSAGE_CHILDREN, &child_usage) != 0)
+        return false;
+    auto micros = [](struct timeval const & value) -> uint64_t {
+        return static_cast<uint64_t>(value.tv_sec) * 1000000ULL +
+            static_cast<uint64_t>(value.tv_usec);
+    };
+    result = (micros(self_usage.ru_utime) + micros(self_usage.ru_stime) +
+        micros(child_usage.ru_utime) + micros(child_usage.ru_stime)) * 1000ULL;
+    return true;
+#endif
+}
+
 void report_profiling_time(std::string const & category, second_duration time) {
     lock_guard<mutex> _(*g_cum_times_mutex);
     (*g_cum_times)[category] += time;
