+    async def _send_shred_group_request(
+        self,
+        *,
+        group_id: str,
+        snippets: List[Dict[str, str]],
+        session: aiohttp.ClientSession,
+        server_url: str,
+    ) -> Dict:
+        """Submit a group once; silent retries could execute proposals twice."""
+        payload = {
+            "snippets": snippets,
+            "timeout": self.request_timeout,
+            "debug": True,
+            "reuse": True,
+            "capture_shred_cpu": True,
+            "capture_shred_group": group_id,
+        }
+        try:
+            timeout = aiohttp.ClientTimeout(
+                total=self.request_timeout + 30,
+                connect=30,
+                sock_read=self.request_timeout + 10,
+            )
+            async with session.post(server_url, json=payload, timeout=timeout) as reply:
+                if reply.status != 200:
+                    return {
+                        "error": f"SHRED group HTTP error {reply.status}",
+                        "error_type": "server_error",
+                        "shred_group_transport_failure": True,
+                    }
+                result = await reply.json()
+                result["error_type"] = self._infer_error_type_from_result(result)
+                return result
+        except asyncio.TimeoutError as exc:
+            return {
+                "error": f"SHRED group client-side HTTP timeout: {exc}",
+                "error_type": "http_timeout",
+                "shred_group_transport_failure": True,
+            }
+        except Exception as exc:
+            return {
+                "error": f"SHRED group request failed: {exc}",
+                "error_type": "server_error",
+                "shred_group_transport_failure": True,
+            }
+
+    async def _verify_shred_group_async(
+        self,
+        *,
+        indices: List[int],
+        responses: List[str],
+        formal_statements: List[str],
+        sample_ids: List[str],
+        group_id: str,
+        session: aiohttp.ClientSession,
+        server_url: str,
+        client_fallback_reason: Optional[str] = None,
+    ) -> Dict[int, Dict]:
+        extracted: Dict[int, Tuple[str, str]] = {}
+        completed: Dict[int, Dict] = {}
+        representatives: Dict[str, int] = {}
+        duplicates: Dict[int, int] = {}
+
+        for index in indices:
