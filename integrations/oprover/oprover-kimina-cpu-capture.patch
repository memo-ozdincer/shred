+    async def capture_checkpoint_receipt(
+        repl: Repl,
+        prepared: list[tuple[str, str]],
+        responses: list[ReplResponse],
+    ) -> None:
+        if not capture_shred_checkpoint:
+            annotate_checkpoint_fallback(responses, "checkpoint_capture_not_requested")
+            return
+        if settings.shred_capture_dir is None:
+            annotate_checkpoint_fallback(responses, "checkpoint_capture_dir_unconfigured")
+            return
+        if len(responses) < capture_shred_checkpoint_min_attempts:
+            annotate_checkpoint_fallback(responses, "checkpoint_group_below_minimum")
+            return
+
+        edge_sets = [
+            exact_tactic_edges(body, response)
+            for (_, body), response in zip(prepared, responses)
+        ]
+        if any(edges is None or not edges for edges in edge_sets):
+            annotate_checkpoint_fallback(responses, "checkpoint_native_edges_missing")
+            return
+        exact_sets = cast(list[list[tuple[str, bytes, int]]], edge_sets)
+        max_prefix = min(len(edges) for edges in exact_sets) - 1
+        prefix_length = 0
+        while prefix_length < max_prefix:
+            expected = exact_sets[0][prefix_length][:2]
+            if any(edges[prefix_length][:2] != expected for edges in exact_sets[1:]):
+                break
+            prefix_length += 1
