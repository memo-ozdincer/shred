+import pytest
+
+from verl.utils.reward_score.lean4_verifier import Lean4Verifier
+
+
+class GroupHarness(Lean4Verifier):
+    def __init__(self) -> None:
+        self.capture_shred_cpu = True
+        self.failure_score = 0.0
+        self.sent = []
+
+    def extract_lean_code(self, response, formal_statement):
+        return response, "fixture"
+
+    async def _send_shred_group_request(
+        self, *, group_id, snippets, session, server_url
+    ):
+        self.sent.append((group_id, snippets, server_url))
+        rows = []
+        for index, snippet in enumerate(snippets):
+            rows.append(
+                {
+                    "id": snippet["id"],
+                    "response": {"tactics": []},
+                    "diagnostics": {
+                        "repl_uuid": "one-repl",
+                        "shred_cpu_boundaries": [],
+                        "shred_group_id": group_id,
+                        "shred_group_index": index,
+                        "shred_group_size": len(snippets),
+                        "shred_group_status": "captured",
+                    },
+                }
+            )
+        return {"results": rows, "error_type": "none"}
+
+    def _finalize_extracted_verification(self, **kwargs):
+        capture = kwargs.get("capture_override")
+        if capture is None:
+            capture = self._extract_shred_cpu_capture(kwargs["verify_result"])
+        return {
+            "success": True,
+            "score": 1.0,
+            "extracted_code": kwargs["extracted_code"],
+            "extraction_method": kwargs["extraction_method"],
+            "error_messages": "",
+            "error_type": "none",
+            "shred_cpu_capture": capture,
+        }
+
+
+@pytest.mark.asyncio
+async def test_group_client_submits_exact_duplicates_once_and_accounts_for_them() -> None:
+    verifier = GroupHarness()
+    results = await verifier._verify_shred_group_async(
+        indices=[0, 1, 2],
+        responses=["proof-a", "proof-a", "proof-b"],
+        formal_statements=["theorem t : True := by sorry"] * 3,
+        sample_ids=["r1_p4_s0", "r1_p4_s1", "r1_p4_s2"],
+        group_id="r1_p4",
+        session=object(),  # type: ignore[arg-type]
+        server_url="http://fixture/api/check",
+    )
+
+    assert [snippet["id"] for snippet in verifier.sent[0][1]] == [
+        "r1_p4_s0",
+        "r1_p4_s2",
+    ]
+    assert set(results) == {0, 1, 2}
+    assert results[0]["shred_cpu_capture"]["status"] == "captured"
+    assert results[1]["shred_cpu_capture"] == {
+        "status": "cached_exact_duplicate",
+        "group_id": "r1_p4",
+        "representative_id": "r1_p4_s0",
+    }
+    assert results[2]["shred_cpu_capture"]["status"] == "captured"
