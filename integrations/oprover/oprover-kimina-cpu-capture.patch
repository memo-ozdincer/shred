+    async def send_control(self, payload: dict[str, Any]) -> dict[str, Any]:
+        if not self.proc or self.proc.returncode is not None:
+            raise ReplError("REPL process not started or shut down")
+        if self.proc.stdin is None or self.proc.stdout is None:
+            raise ReplError("REPL pipes are not initialized")
+
+        encoded = (json.dumps(payload, ensure_ascii=False) + "\n\n").encode("utf-8")
+        try:
+            self.proc.stdin.write(encoded)
+            await self.proc.stdin.drain()
+        except Exception as exc:
+            raise LeanError("Failed to write REPL control command") from exc
+        raw = await self._read_response()
+
+        self.error_file.seek(0)
