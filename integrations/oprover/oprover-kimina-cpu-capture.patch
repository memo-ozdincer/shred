+    def _finalize_extracted_verification(
+        self,
+        *,
+        response: str,
+        formal_statement: str,
+        extracted_code: str,
+        extraction_method: str,
+        verify_result: Dict,
+        capture_override: Optional[Dict] = None,
+    ) -> Dict:
+        """Apply the ordinary verifier's verdict and reward policy to one server row."""
+        result = {
+            "success": False,
+            "score": self.failure_score,
+            "extracted_code": extracted_code,
+            "error_messages": "",
+            "extraction_method": extraction_method,
+            "error_type": verify_result.get(
+                "error_type", self._infer_error_type_from_result(verify_result)
+            ),
+        }
+        verify_result["error_type"] = result["error_type"]
+        capture = capture_override
+        if capture is None:
+            capture = self._extract_shred_cpu_capture(verify_result)
+        if capture is not None:
+            result["shred_cpu_capture"] = capture
+
+        is_success = self.is_proof_successful(verify_result)
+        is_trivial = False
+        if is_success and formal_statement and response:
+            raw_code, _ = self._extract_raw_code_for_trivial_check(response)
+            if raw_code:
+                is_trivial = self.is_trivial_abbrev_solution(
+                    formal_statement, raw_code
+                )
+                if is_trivial:
+                    is_success = False
+                    result["is_trivial_solution"] = True
+        result["success"] = is_success
+
+        if self.enable_format_reward:
+            if is_success:
+                format_result = self.format_checker.check_format(response, extracted_code)
+                result["format_correct"] = format_result["format_correct"]
+                result["format_score"] = format_result["format_score"]
+                result["missing_sections"] = format_result["missing_sections"]
+            else:
+                result["format_correct"] = 0
+                result["format_score"] = 0.0
+                result["missing_sections"] = 0
+            result["lean4_score"] = self.lean4_success_score if is_success else 0.0
+            result["score"] = result["format_score"] + result["lean4_score"]
+        else:
+            result["score"] = self.success_score if is_success else self.failure_score
+            result["format_correct"] = None
+            result["format_score"] = None
+            result["lean4_score"] = result["score"]
+
+        if is_success:
