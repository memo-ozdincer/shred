+    def _extract_shred_cpu_capture(self, verify_result: Dict) -> Optional[Dict]:
+        if not self.capture_shred_cpu:
+            return None
+        rows = verify_result.get("results")
+        if not isinstance(rows, list) or len(rows) != 1:
+            return {
+                "status": "fallback",
+                "fallback_reason": "missing_single_attributable_server_result",
+            }
+        row = rows[0]
+        diagnostics = row.get("diagnostics") if isinstance(row, dict) else None
+        response = row.get("response") if isinstance(row, dict) else None
+        boundaries = (
+            diagnostics.get("shred_cpu_boundaries")
+            if isinstance(diagnostics, dict)
+            else None
+        )
+        tactics = response.get("tactics") if isinstance(response, dict) else None
+        group_status = (
+            diagnostics.get("shred_group_status")
+            if isinstance(diagnostics, dict)
+            else None
+        )
+        if group_status == "fallback":
+            return {
+                "status": "fallback",
+                "fallback_reason": diagnostics.get(
+                    "shred_group_fallback_reason", "group_capture_failed"
+                ),
+                "group_id": diagnostics.get("shred_group_id"),
+            }
+        if not isinstance(boundaries, list) or not isinstance(tactics, list):
+            return {
+                "status": "fallback",
+                "fallback_reason": "missing_native_cpu_or_tactic_telemetry",
+            }
+        capture = {
+            "status": "captured",
+            "cpu_boundaries": boundaries,
+            "native_tactics": tactics,
+        }
