+            for row in rows:
+                row_id = row.get("id") if isinstance(row, dict) else None
+                if not isinstance(row_id, str) or row_id in rows_by_id:
+                    receipt_reason = receipt_reason or "group_response_duplicate_or_invalid_id"
+                    continue
+                rows_by_id[row_id] = row
+            if set(rows_by_id) != expected_ids:
+                receipt_reason = receipt_reason or "group_response_id_mismatch"
+
+        if receipt_reason is None:
+            receipts = []
+            for index in representative_indices:
+                row = rows_by_id[sample_ids[index]]
+                diagnostics = row.get("diagnostics")
+                receipts.append(diagnostics if isinstance(diagnostics, dict) else {})
+            captured = [r for r in receipts if r.get("shred_group_status") == "captured"]
+            fallback = [r for r in receipts if r.get("shred_group_status") == "fallback"]
+            if captured and fallback:
+                receipt_reason = "group_receipt_mixed_status"
+            elif captured:
+                repls = {r.get("repl_uuid") for r in captured}
+                indices_seen = {r.get("shred_group_index") for r in captured}
+                expected_positions = set(range(len(representative_indices)))
+                if (
+                    any(r.get("shred_group_id") != group_id for r in captured)
+                    or any(
+                        r.get("shred_group_size") != len(representative_indices)
+                        for r in captured
+                    )
+                    or indices_seen != expected_positions
+                    or len(repls) != 1
+                    or None in repls
+                ):
+                    receipt_reason = "group_receipt_mismatch"
+                checkpoint_statuses = {
+                    r.get("shred_checkpoint_status") for r in captured
+                }
+                if len(checkpoint_statuses) != 1 or None in checkpoint_statuses:
+                    receipt_reason = receipt_reason or "checkpoint_receipt_mixed_status"
+                elif checkpoint_statuses == {"captured"}:
+                    checkpoint_fields = (
+                        "shred_checkpoint_prefix_length",
+                        "shred_prefix_edges_sha256",
+                        "shred_parent_environment_sha256",
+                        "shred_root_context_sha256",
+                        "shred_checkpoint_artifact_sha256",
+                        "shred_checkpoint_artifact_id",
+                    )
+                    checkpoint_receipts = {
+                        tuple(r.get(field) for field in checkpoint_fields)
+                        for r in captured
+                    }
+                    prefix_length = captured[0].get(
+                        "shred_checkpoint_prefix_length"
+                    )
+                    checkpoint_values = next(iter(checkpoint_receipts))
+                    digests = checkpoint_values[1:5]
+                    artifact_id = checkpoint_values[5]
+                    if (
+                        len(checkpoint_receipts) != 1
+                        or not isinstance(prefix_length, int)
+                        or isinstance(prefix_length, bool)
+                        or prefix_length < 1
+                        or any(
+                            not isinstance(value, str)
+                            or re.fullmatch(r"[0-9a-f]{64}", value) is None
+                            for value in digests
+                        )
+                        or not isinstance(artifact_id, str)
+                        or not artifact_id
+                        or any(
+                            prefix_length >= len(
+                                (row.get("response") or {}).get("tactics") or []
+                            )
+                            for row in rows_by_id.values()
+                        )
+                    ):
+                        receipt_reason = receipt_reason or "checkpoint_receipt_mismatch"
+                elif checkpoint_statuses == {"fallback"}:
+                    fallback_reasons = {
+                        r.get("shred_checkpoint_fallback_reason") for r in captured
+                    }
+                    if len(fallback_reasons) != 1 or None in fallback_reasons:
+                        receipt_reason = receipt_reason or "checkpoint_fallback_mismatch"
+                else:
+                    receipt_reason = receipt_reason or "checkpoint_receipt_invalid_status"
+            elif not fallback:
+                receipt_reason = "group_receipt_missing_status"
+
+        for index in representative_indices:
+            row = rows_by_id.get(sample_ids[index])
+            if row is None:
+                single = {
+                    "error": verify_result.get("error", "Missing attributable group result"),
+                    "error_type": verify_result.get("error_type", "server_error"),
+                }
+            else:
+                single = {"results": [row]}
+                single["error_type"] = self._infer_error_type_from_result(single)
+            override = None
+            if receipt_reason is not None:
+                override = self._capture_fallback(receipt_reason, group_id)
+            completed[index] = self._finalize_extracted_verification(
+                response=responses[index],
+                formal_statement=formal_statements[index],
+                extracted_code=extracted[index][0],
+                extraction_method=extracted[index][1],
+                verify_result=single,
+                capture_override=override,
+            )
+
+        for duplicate_index, representative_index in duplicates.items():
+            copied = copy.deepcopy(completed[representative_index])
+            copied["extracted_code"] = extracted[duplicate_index][0]
+            copied["extraction_method"] = extracted[duplicate_index][1]
+            copied["shred_cpu_capture"] = {
+                "status": "cached_exact_duplicate",
+                "group_id": group_id,
+                "representative_id": sample_ids[representative_index],
+            }
+            completed[duplicate_index] = copied
+        return completed
+
+    async def _verify_shred_groups_async(
+        self,
+        responses: List[str],
+        formal_statements: List[str],
+        sample_ids: List[str],
+        max_workers_override: Optional[int] = None,
+    ) -> List[Dict]:
+        total = len(responses)
+        if not (len(formal_statements) == total == len(sample_ids)):
+            raise ValueError("responses, formal_statements, and sample_ids must align")
+
+        grouped: Dict[Tuple[str, str], List[int]] = defaultdict(list)
+        client_fallbacks: Dict[Tuple[str, str], str] = {}
+        seen_ids = set()
+        for index, sample_id in enumerate(sample_ids):
+            match = self._SHRED_SAMPLE_ID.fullmatch(sample_id or "")
+            if match is None or sample_id in seen_ids:
+                key = ("fallback", str(index))
+                grouped[key].append(index)
+                client_fallbacks[key] = (
+                    "duplicate_sample_id" if sample_id in seen_ids else "unsupported_sample_id"
+                )
+            else:
+                key = (match.group("round"), match.group("prompt"))
+                grouped[key].append(index)
+            seen_ids.add(sample_id)
+
+        for key, indices in list(grouped.items()):
+            if len({formal_statements[index] for index in indices}) != 1:
+                del grouped[key]
+                for index in indices:
+                    split_key = ("formal_fallback", str(index))
+                    grouped[split_key] = [index]
+                    client_fallbacks[split_key] = "group_formal_statements_differ"
+
+        num_servers = max(1, len(self.server_urls))
+        effective_workers = (
+            max_workers_override if max_workers_override is not None else self.max_workers
+        )
+        per_server = max(1, effective_workers // num_servers)
+        semaphores = [asyncio.Semaphore(per_server) for _ in range(num_servers)]
+        connector = aiohttp.TCPConnector(
+            limit=per_server * num_servers,
+            limit_per_host=per_server,
+            ttl_dns_cache=300,
+            force_close=False,
+        )
+        completed: Dict[int, Dict] = {}
+
+        async with aiohttp.ClientSession(connector=connector) as session:
+            async def run_group(sequence: int, key, indices):
+                server_index = sequence % num_servers
+                group_id = (
+                    f"r{key[0]}_p{key[1]}"
+                    if key[0].isdigit() and key[1].isdigit()
+                    else f"client_fallback_{indices[0]}"
+                )
+                async with semaphores[server_index]:
+                    result = await self._verify_shred_group_async(
+                        indices=indices,
+                        responses=responses,
+                        formal_statements=formal_statements,
+                        sample_ids=sample_ids,
+                        group_id=group_id,
+                        session=session,
+                        server_url=self.server_urls[server_index],
+                        client_fallback_reason=client_fallbacks.get(key),
+                    )
+                    completed.update(result)
+
+            tasks = [
+                asyncio.create_task(run_group(sequence, key, indices))
+                for sequence, (key, indices) in enumerate(grouped.items())
+            ]
+            try:
+                await asyncio.wait_for(
+                    asyncio.gather(*tasks),
+                    timeout=self.request_timeout + self.batch_timeout_buffer,
+                )
+            except asyncio.TimeoutError:
+                for task in tasks:
+                    task.cancel()
+            except Exception as exc:
+                logger.error(f"[SHRED Group] Unexpected batch error: {exc}")
+
+        final = []
+        for index in range(total):
+            if index in completed:
+                final.append(completed[index])
+            else:
+                final.append(
+                    {
+                        "success": False,
+                        "score": self.failure_score,
+                        "extracted_code": "",
+                        "error_messages": "SHRED group batch did not return an attributable result",
+                        "extraction_method": "error",
+                        "error_type": "batch_timeout",
+                        "shred_cpu_capture": self._capture_fallback(
+                            "group_batch_incomplete"
+                        ),
+                    }
+                )
+        return final
+
