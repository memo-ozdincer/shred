+                    "score": self.failure_score,
+                    "extracted_code": "",
+                    "error_messages": f"Failed to extract Lean code: {method}",
+                    "extraction_method": method,
+                    "error_type": "extraction_error",
+                    "shred_cpu_capture": self._capture_fallback(
+                        "proposal_extraction_failed", group_id
+                    ),
+                }
+                continue
+            extracted[index] = (code, method)
+            key = self._cache_key(formal_statements[index], code)
+            if key in representatives:
+                duplicates[index] = representatives[key]
+            else:
+                representatives[key] = index
+
+        representative_indices = list(representatives.values())
+        if not representative_indices:
+            return completed
+
+        snippets = [
+            {"id": sample_ids[index], "code": extracted[index][0]}
+            for index in representative_indices
+        ]
+        verify_result = await self._send_shred_group_request(
+            group_id=group_id,
+            snippets=snippets,
+            session=session,
+            server_url=server_url,
+        )
+
+        rows = verify_result.get("results")
+        rows_by_id: Dict[str, Dict] = {}
+        receipt_reason = client_fallback_reason
+        if verify_result.get("shred_group_transport_failure"):
+            receipt_reason = receipt_reason or "group_transport_failure_no_retry"
+        elif not isinstance(rows, list):
+            receipt_reason = receipt_reason or "group_response_missing_results"
+        else:
+            expected_ids = {sample_ids[index] for index in representative_indices}
+            for row in rows:
+                row_id = row.get("id") if isinstance(row, dict) else None
+                if not isinstance(row_id, str) or row_id in rows_by_id:
+                    receipt_reason = receipt_reason or "group_response_duplicate_or_invalid_id"
+                    continue
+                rows_by_id[row_id] = row
+            if set(rows_by_id) != expected_ids:
+                receipt_reason = receipt_reason or "group_response_id_mismatch"
+
+        if receipt_reason is None:
+            receipts = []
+            for index in representative_indices:
+                row = rows_by_id[sample_ids[index]]
+                diagnostics = row.get("diagnostics")
+                receipts.append(diagnostics if isinstance(diagnostics, dict) else {})
+            captured = [r for r in receipts if r.get("shred_group_status") == "captured"]
+            fallback = [r for r in receipts if r.get("shred_group_status") == "fallback"]
+            if captured and fallback:
