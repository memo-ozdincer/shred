+            override = None
+            if receipt_reason is not None:
+                override = self._capture_fallback(receipt_reason, group_id)
+            completed[index] = self._finalize_extracted_verification(
+                response=responses[index],
+                formal_statement=formal_statements[index],
+                extracted_code=extracted[index][0],
+                extraction_method=extracted[index][1],
+                verify_result=single,
+                capture_override=override,
+            )
+
+        for duplicate_index, representative_index in duplicates.items():
+            copied = copy.deepcopy(completed[representative_index])
+            copied["extracted_code"] = extracted[duplicate_index][0]
+            copied["extraction_method"] = extracted[duplicate_index][1]
+            copied["shred_cpu_capture"] = {
+                "status": "cached_exact_duplicate",
+                "group_id": group_id,
+                "representative_id": sample_ids[representative_index],
+            }
+            completed[duplicate_index] = copied
+        return completed
