+            raise ReplError("JSON decode error in REPL control response") from exc
+        if not isinstance(response, dict):
+            raise ReplError("REPL control response is not an object")
+        message = response.get("message")
+        if isinstance(message, str) and message:
+            raise LeanError(message)
+        return response
