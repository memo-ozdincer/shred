+    def exact_tactic_edges(
+        body: str, response: ReplResponse
+    ) -> list[tuple[str, bytes, int]] | None:
+        command = "set_option shred.cpuBoundaries true\n" + body
+        command_bytes = command.encode("utf-8")
+        payload = response.response
+        tactics = payload.get("tactics") if isinstance(payload, dict) else None
+        if not isinstance(tactics, list):
+            return None
+        edges: list[tuple[str, bytes, int]] = []
+        for tactic in tactics:
+            if not isinstance(tactic, dict):
+                return None
+            start = tactic.get("startByte")
+            stop = tactic.get("endByte")
+            kind = tactic.get("syntaxKind")
+            proof_state = tactic.get("proofState")
+            if (
+                isinstance(start, bool)
+                or isinstance(stop, bool)
+                or isinstance(proof_state, bool)
+                or not isinstance(start, int)
+                or not isinstance(stop, int)
+                or not isinstance(proof_state, int)
+                or not isinstance(kind, str)
+                or not kind
+                or start < 0
+                or stop <= start
+                or stop > len(command_bytes)
+            ):
+                return None
+            edges.append((kind, command_bytes[start:stop], proof_state))
