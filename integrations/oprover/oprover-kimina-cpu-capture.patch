+from uuid import UUID
+from pathlib import Path
+
+import pytest
+from kimina_client import CommandResponse, ReplResponse, Snippet
+
+from server.errors import NoAvailableReplError
+from server.routers.check import run_checks
+from server.settings import settings
+
+
+class FakeCaptureRepl:
+    def __init__(self) -> None:
+        self.uuid = UUID("00000000-0000-0000-0000-000000000123")
+        self.sent: list[str] = []
+
+    async def send_timeout(self, snippet: Snippet, *args, **kwargs) -> ReplResponse:
+        self.sent.append(snippet.code)
+        return ReplResponse(
+            id=snippet.id,
+            response=CommandResponse(env=0),
+            diagnostics={
+                "repl_uuid": str(self.uuid),
+                "shred_cpu_boundaries": [
+                    "SHRED_CPU_BOUNDARY_V1\t0\t0\t1\t2\tparsing\t_anonymous"
+                ],
+            },
+        )
+
+
+class FakeCaptureManager:
+    def __init__(self) -> None:
+        self.repl = FakeCaptureRepl()
+        self.get_calls = 0
+        self.prep_calls = 0
+        self.release_calls = 0
+        self.destroy_calls = 0
+
+    async def get_repl(self, header: str, snippet_id: str, **kwargs):
+        self.get_calls += 1
+        assert kwargs == {"reuse": False, "capture_shred_cpu": True}
+        return self.repl
+
+    async def prep(self, repl, snippet_id: str, timeout: float, debug: bool):
+        self.prep_calls += 1
+        assert repl is self.repl
+        assert debug is True
+        return None
+
+    async def release_repl(self, repl) -> None:
+        assert repl is self.repl
+        self.release_calls += 1
+
+    async def destroy_repl(self, repl) -> None:
+        self.destroy_calls += 1
+
+
+@pytest.mark.asyncio
+async def test_capture_group_leases_one_repl_for_every_member() -> None:
+    manager = FakeCaptureManager()
+    snippets = [
+        Snippet(id="r1_p7_s0", code="import Mathlib\ntheorem t : True := by trivial"),
+        Snippet(
+            id="r1_p7_s1",
+            code="import Mathlib\ntheorem t : True := by exact True.intro",
+        ),
+    ]
+
+    results = await run_checks(
+        snippets,
+        timeout=10,
+        debug=True,
+        manager=manager,  # type: ignore[arg-type]
+        reuse=True,
+        capture_shred_cpu=True,
+        capture_shred_group="r1_p7",
+    )
+
+    assert manager.get_calls == 1
+    assert manager.prep_calls == 1
+    assert manager.release_calls == 1
+    assert manager.destroy_calls == 0
+    assert manager.repl.sent == [
+        "theorem t : True := by trivial",
+        "theorem t : True := by exact True.intro",
+    ]
+    assert [result.id for result in results] == [snippet.id for snippet in snippets]
+    assert {
+        result.diagnostics["repl_uuid"]  # type: ignore[index]
+        for result in results
+    } == {str(manager.repl.uuid)}
+    assert [
+        result.diagnostics["shred_group_index"]  # type: ignore[index]
+        for result in results
+    ] == [0, 1]
+    assert all(
+        result.diagnostics["shred_group_id"] == "r1_p7"  # type: ignore[index]
+        and result.diagnostics["shred_group_size"] == 2  # type: ignore[index]
+        and result.diagnostics["shred_group_status"] == "captured"  # type: ignore[index]
+        for result in results
+    )
+
+
+@pytest.mark.asyncio
+async def test_capture_group_repl_failure_is_attributable_to_every_member() -> None:
+    class UnavailableManager:
+        async def get_repl(self, *args, **kwargs):
+            raise NoAvailableReplError("full")
+
+    snippets = [
+        Snippet(id="r2_p3_s0", code="import Mathlib\ntheorem t : True := by trivial"),
+        Snippet(
+            id="r2_p3_s1",
+            code="import Mathlib\ntheorem t : True := by exact True.intro",
+        ),
+    ]
+    results = await run_checks(
+        snippets,
+        timeout=10,
+        debug=True,
+        manager=UnavailableManager(),  # type: ignore[arg-type]
+        reuse=True,
+        capture_shred_cpu=True,
+        capture_shred_group="r2_p3",
+    )
+
+    assert [result.id for result in results] == [snippet.id for snippet in snippets]
+    assert all(result.error for result in results)
+    assert all(
+        result.diagnostics["shred_group_status"] == "fallback"  # type: ignore[index]
+        and result.diagnostics["shred_group_fallback_reason"]  # type: ignore[index]
+        == "group_repl_unavailable"
+        for result in results
+    )
+
+
+@pytest.mark.asyncio
+async def test_capture_group_pickles_one_exact_representative_checkpoint(
+    tmp_path: Path, monkeypatch
+) -> None:
+    class CheckpointRepl(FakeCaptureRepl):
+        def __init__(self) -> None:
+            super().__init__()
+            self.next_state = 0
+            self.pickles = []
+
+        async def send_timeout(self, snippet: Snippet, *args, **kwargs) -> ReplResponse:
+            self.sent.append(snippet.code)
+            command = "set_option shred.cpuBoundaries true\n" + snippet.code
+            first_start = len(command[: command.index("simp")].encode("utf-8"))
+            second_text = "trivial" if "trivial" in snippet.code else "exact True.intro"
+            second_start = len(
+                command[: command.index(second_text)].encode("utf-8")
+            )
+            root_state = self.next_state
+            self.next_state += 2
+            return ReplResponse(
+                id=snippet.id,
+                response={
+                    "env": 0,
+                    "tactics": [
+                        {
+                            "startByte": first_start,
+                            "endByte": first_start + len("simp"),
+                            "syntaxKind": "Lean.Parser.Tactic.simp",
+                            "proofState": root_state,
+                        },
+                        {
+                            "startByte": second_start,
+                            "endByte": second_start + len(second_text),
+                            "syntaxKind": "Lean.Parser.Tactic.tacticSeq1Indented",
+                            "proofState": root_state + 1,
+                        },
+                    ],
+                },
+                diagnostics={
+                    "repl_uuid": str(self.uuid),
+                    "shred_cpu_boundaries": [],
+                },
+            )
+
+        async def pickle_environment_timeout(self, env, path, timeout):
+            path.write_bytes(f"environment:{env}".encode())
+            self.pickles.append(("environment", env, path))
+            return {"env": env}
+
+        async def pickle_proof_state_timeout(self, proof_state, path, timeout):
+            path.write_bytes(f"proof:{proof_state}".encode())
+            self.pickles.append(("proof", proof_state, path))
+            return {"proofState": proof_state}
+
+    manager = FakeCaptureManager()
+    manager.repl = CheckpointRepl()
+    monkeypatch.setattr(settings, "shred_capture_dir", tmp_path)
+    snippets = [
+        Snippet(
+            id=f"r3_p2_s{index}",
+            code=(
+                "import Mathlib\ntheorem t : True := by\n  simp\n  "
+                + ("trivial" if index % 2 else "exact True.intro")
+            ),
+        )
+        for index in range(8)
+    ]
+    results = await run_checks(
+        snippets,
+        timeout=10,
+        debug=True,
+        manager=manager,  # type: ignore[arg-type]
+        reuse=True,
+        capture_shred_cpu=True,
+        capture_shred_group="r3_p2",
+        capture_shred_checkpoint=True,
+        capture_shred_checkpoint_min_attempts=8,
+    )
+
+    assert [(kind, state) for kind, state, _ in manager.repl.pickles] == [
+        ("environment", 0),
+        ("proof", 0),
+        ("proof", 1),
+    ]
+    receipts = [result.diagnostics for result in results]
+    assert all(receipt["shred_checkpoint_status"] == "captured" for receipt in receipts)
+    assert all(receipt["shred_checkpoint_prefix_length"] == 1 for receipt in receipts)
+    assert len({receipt["shred_checkpoint_artifact_sha256"] for receipt in receipts}) == 1
